# Copy to android/keystore.properties (git-ignored) to sign release builds
# with your own key. Create the key once (JDK keytool):
#   keytool -genkeypair -v -keystore release.keystore -alias nexa -keyalg RSA -keysize 2048 -validity 10000
# Keep the file and the passwords safe: an APK signed with a different key
# will not install over the old one (uninstall first).
storeFile=release.keystore
storePassword=change-me
keyAlias=nexa
keyPassword=change-me
