{
  "manifest_version": 3,
  "name": "Nexa AI Bot",
  "version": "1.2.0",
  "description": "Nexa AI trading assistant that runs on the Quotex trading platform.",

  "minimum_chrome_version": "111",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_title": "Nexa AI Bot — settings & status",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "permissions": [
    "storage"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://market-qx.trade/*",
        "https://*.market-qx.trade/*",
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.io/*",
        "https://*.quotex.io/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://*.quotex-market.com/*",
        "https://*.qx-market.com/*",
        "https://*.market-qx.pro/*",
        "https://*.qxbroker.io/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://market-qx.trade/*",
        "https://*.market-qx.trade/*",
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.io/*",
        "https://*.quotex.io/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://*.quotex-market.com/*",
        "https://*.qx-market.com/*",
        "https://*.market-qx.pro/*",
        "https://*.qxbroker.io/*"
      ],
      "js": [
        "strategy.js",
        "autopilot.js",
        "horizons.js",
        "candles.js",
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "style.css"
      ],
      "matches": [
        "https://market-qx.trade/*",
        "https://*.market-qx.trade/*",
        "https://qxbroker.com/*",
        "https://*.qxbroker.com/*",
        "https://quotex.io/*",
        "https://*.quotex.io/*",
        "https://quotex.com/*",
        "https://*.quotex.com/*",
        "https://*.quotex-market.com/*",
        "https://*.qx-market.com/*",
        "https://*.market-qx.pro/*",
        "https://*.qxbroker.io/*"
      ]
    }
  ]
}
